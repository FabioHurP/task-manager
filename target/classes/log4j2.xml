<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="LOG_PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n
        </Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>
        <!-- <File name="File" fileName="logs/app.log" append="true">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %highlight{%-5level}{FATAL=red, ERROR=red, WARN=yellow, INFO=green, DEBUG=blue} %logger{36} - %msg%n"/>
        </File> -->
        <RollingFile name="TaskServiceFile"
                     fileName="logs/task-service.log"
                     filePattern="logs/task-service-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="1KB"/>
            </Policies>
        </RollingFile>

        <RollingFile name="ValidationServiceFile"
                     fileName="logs/validation-service.log"
                     filePattern="logs/validation-service-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="1MB"/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="fabio.taskmanager.service.TaskService" level="DEBUG" additivity="false">
            <AppenderRef ref="TaskServiceFile"/>
        </Logger>
        <Logger name="fabio.taskmanager.service.TaskValidationService" level="DEBUG" additivity="false">
            <AppenderRef ref="ValidationServiceFile"/>
        </Logger>
        <Root level="DEBUG">
            <AppenderRef ref="Console"/>
            <!-- <AppenderRef ref="File"/> -->
        </Root>
    </Loggers>

</Configuration>